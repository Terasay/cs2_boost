{
  "name": "cs2-boost",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "dev:pages": "node scripts/pages-demo.mjs dev",
    "build:pages": "node scripts/pages-demo.mjs build",
    "preview:pages": "node scripts/pages-demo.mjs preview",
    "start": "node --env-file-if-exists=.env.local node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:security": "node --test scripts/security.test.mjs",
    "test:two-factor": "node --test scripts/two-factor.test.mjs",
    "test:two-factor:smoke": "node scripts/two-factor-smoke.mjs",
    "test:chat": "node --test scripts/chat.test.mjs scripts/chat-vault.test.mjs",
    "test:pricing": "node --test scripts/pricing.test.mjs",
    "test:donationalerts": "node --test scripts/donationalerts.test.mjs",
    "test:donationalerts:smoke": "node scripts/donationalerts-smoke.mjs",
    "test:payments": "node scripts/order-payments-smoke.mjs",
    "test:orders": "node scripts/order-smoke.mjs",
    "test:mail": "node --test scripts/mail.test.mjs",
    "test:mail:smoke": "node scripts/mail-smoke.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "admin:set": "node --env-file-if-exists=.env.local scripts/set-admin.mjs",
    "test:deployment": "node --test scripts/deployment.test.mjs scripts/update-script.test.mjs",
    "test:marketing": "node --test scripts/marketing.test.mjs",
    "test:seo": "node scripts/seo-smoke.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
