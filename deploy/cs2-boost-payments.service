[Unit]
Description=CS2 Boost payment matching
After=cs2-boost.service

[Service]
Type=oneshot
User=cs2boost
Group=cs2boost
WorkingDirectory=/opt/cs2-boost
EnvironmentFile=/etc/cs2-boost.env
ExecStart=/opt/node24/bin/node scripts/payment-sync.mjs
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=96M
TasksMax=16
